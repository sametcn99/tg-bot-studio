# ===========================================================================
# Core Credentials & Server Config
# ===========================================================================

# Master administration key for the Studio dashboard.
# Hashed with Argon2id into SQLite on first boot.
# PRODUCTION REFUSES TO BOOT with this default — set a strong value.
ADMIN_MASTER_KEY=admin123

# Secret used to sign JWT session tokens (7-day sessions, HttpOnly cookie).
# PRODUCTION REFUSES TO BOOT with this default — use a long random string.
JWT_SECRET=change_this_secret_in_production

# Port for the unified fullstack server (API + dashboard + mini apps)
PORT=3000

# Public domain/URL (e.g. https://tgstudio.yourdomain.com).
# On Coolify: automatically populated by ${SERVICE_FQDN_STUDIO} or ${COOLIFY_URL}.
# Used for Telegram Mini App menu URLs and CORS origins.
APP_URL=http://localhost:3000

# Reverse proxy hops (1 for Coolify / Traefik / Caddy / Nginx; set 2 if behind Cloudflare + Coolify)
TRUST_PROXY=1

# Allowed CORS origins for split hosting (comma separated, e.g. "https://a.example.com,https://b.example.com").
# When empty, same-origin + APP_URL is automatically permitted.
#CORS_ORIGINS=

# Persistent data directory and SQLite database file path
DATA_DIR=./data
DB_PATH=./data/studio.sqlite

# Prisma SQLite datasource (relative to the prisma/ folder).
DATABASE_URL="file:../data/studio.sqlite"

# ---------------------------------------------------------------------------
# Optional hardening & operations
# ---------------------------------------------------------------------------

# Bearer token that Prometheus scrapers must send to GET /api/metrics.
# When unset, the endpoint only accepts authenticated dashboard sessions.
#METRICS_BEARER_TOKEN=

# Studio-wide fallback alert bot (token + chat id) used by the health monitor
# when a sick bot cannot deliver its own alerts (e.g. a revoked token).
#HEALTH_ALERT_BOT_TOKEN=
#HEALTH_ALERT_CHAT_ID=

# Allow outgoing webhooks to target private/loopback addresses (lab use only).
#WEBHOOKS_ALLOW_PRIVATE=0

# Set to 1 to disable the automatic nightly database backup.
#DISABLE_NIGHTLY_BACKUP=0

# Retention windows in days (0 disables that prune). Defaults below.
#RETENTION_AI_CHAT_DAYS=90
#RETENTION_SUPPORT_DAYS=180
#RETENTION_SECURITY_LOGS_DAYS=180
#RETENTION_ORDERS_DAYS=365
#RETENTION_LINKS_DAYS=90
#RETENTION_HEALTH_DAYS=30
#RETENTION_BROADCASTS_DAYS=180
#RETENTION_SESSIONS_DAYS=30
#RETENTION_FLOW_STATE_ORPHAN_DAYS=30
#RETENTION_VOLUME_KEYS_DAYS=7
