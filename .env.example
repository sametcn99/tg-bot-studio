# Master administration key for the Studio dashboard.
# Hashed with Argon2id into SQLite on first boot. Default fallback: admin123
ADMIN_MASTER_KEY=admin123

# Port for the unified fullstack server (API + dashboard + mini apps)
PORT=3000

# Secret used to sign JWT session tokens. Change this in production.
JWT_SECRET=change_this_secret_in_production

# Persistent data directory and SQLite database file path
DATA_DIR=./data
DB_PATH=./data/studio.sqlite
