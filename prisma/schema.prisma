datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

model Bot {
  id        String     @id @default(uuid())
  name      String
  token     String  @unique
  username  String?
  firstName String? @map("first_name")
  isActive  Int     @default(1) @map("is_active")
  createdAt String? @map("created_at")
  updatedAt String? @map("updated_at")

  modules          BotModule[]
  miniApps         MiniApp[]
  miniAppOrders    MiniAppOrder[]
  settings         BotSetting[]
  users            BotUser[]
  links            Link[]
  broadcasts       Broadcast[]
  supportMessages  SupportMessage[]
  dripCampaigns    DripCampaign[]
  dripSubscribers  DripSubscriber[]
  giveaways        Giveaway[]
  scheduledPosts   ScheduledPost[]
  blockedUsers     BlockedUser[]
  groups           BotGroup[]
  connections      ChatConnection[]
  autoresponders   Autoresponder[]
  vipSubscriptions VipSubscription[]
  chatActivities   ChatActivity[]
  scoreSchedules   ScoreSchedule[]
  aiChatHistories  AiChatHistory[]
  aiKnowledgeDocs  AiKnowledgeDoc[]
  aiKnowledgeChunks AiKnowledgeChunk[]
  chatModuleSettings ChatModuleSetting[]
  chatMemberStates ChatMemberState[]
  chatWarns        ChatWarn[]
  chatApprovals    ChatApproval[]
  fedChats         FedChat[]
  mediaAssets      MediaAsset[]
  flows            Flow[]
  flowStates       FlowState[]
  healthEvents     HealthEvent[]

  @@map("bots")
}

/// Reference-parity per-chat module configuration override. Effective config for a
/// chat is registry defaults <- bot-level `bot_modules.config_json` <- this.
model ChatModuleSetting {
  botId      String    @map("bot_id")
  chatId     String @map("chat_id")
  moduleKey  String @map("module_key")
  configJson String @map("config_json")

  bot Bot @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@id([botId, chatId, moduleKey])
  @@map("chat_module_settings")
}

/// Persistent per-member moderation state: strike counters, captcha solved
/// flag, active mute expiry, and module scratch data (flood windows, ...).
model ChatMemberState {
  botId           String     @map("bot_id")
  chatId          String  @map("chat_id")
  telegramId      BigInt  @map("telegram_id")
  strikes         Int     @default(0)
  captchaVerified Int     @default(0) @map("captcha_verified")
  mutedUntil      String? @map("muted_until")
  dataJson        String? @map("data_json")
  updatedAt       String? @map("updated_at")

  bot Bot @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@id([botId, chatId, telegramId])
  @@map("chat_member_state")
}

/// Individual warning event issued by admins or automated blocklists.
model ChatWarn {
  id          String    @id @default(uuid())
  botId       String    @map("bot_id")
  chatId      String @map("chat_id")
  telegramId  BigInt @map("telegram_id")
  reason      String
  createdAt   String? @map("created_at")

  bot Bot @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@index([botId, chatId, telegramId])
  @@map("chat_warns")
}

/// Reference-style approved users: immune to automated moderation (flood,
/// blocklists, locks) while staying enforced for everyone else.
model ChatApproval {
  botId      String     @map("bot_id")
  chatId     String  @map("chat_id")
  telegramId BigInt  @map("telegram_id")
  reason     String?
  approvedAt String? @map("approved_at")

  bot Bot @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@id([botId, chatId, telegramId])
  @@map("chat_approvals")
}

/// A ban federation: shared ban list enforced across every joined chat of
/// every bot in the studio (reference federations, generalized cross-bot).
model Fed {
  id               String  @id @default(uuid())
  name             String
  /// Telegram id of the owning user (fed creator).
  ownerTelegramId  BigInt  @map("owner_telegram_id")
  /// Studio bot through which the federation was created.
  ownerBotId       String     @map("owner_bot_id")
  /// Optional channel/group that receives federation log events.
  logChatId        BigInt? @map("log_chat_id")
  fedReasonRequired Int    @default(0) @map("fed_reason_required")
  createdAt        String? @map("created_at")

  bans    FedBan[]
  admins  FedAdmin[]
  chats   FedChat[]
  subs    FedSub[] @relation("FedSubscriptions")
  subbedBy FedSub[] @relation("FedSubscribers")

  @@map("feds")
}

/// A banned user inside a federation.
model FedBan {
  fedId       String  @map("fed_id")
  telegramId  BigInt  @map("telegram_id")
  reason      String
  bannedBy    BigInt  @map("banned_by")
  createdAt   String? @map("created_at")

  fed Fed @relation(fields: [fedId], references: [id], onDelete: Cascade)

  @@id([fedId, telegramId])
  @@map("fed_bans")
}

/// A federation administrator (beyond the owner).
model FedAdmin {
  fedId      String @map("fed_id")
  telegramId BigInt @map("telegram_id")

  fed Fed @relation(fields: [fedId], references: [id], onDelete: Cascade)

  @@id([fedId, telegramId])
  @@map("fed_admins")
}

/// A chat joined to a federation — scoped per studio bot so every bot in
/// the studio can enforce the same fed.
model FedChat {
  fedId   String @map("fed_id")
  botId   String    @map("bot_id")
  chatId  String @map("chat_id")
  quiet   Int    @default(0)
  joinedAt String? @map("joined_at")

  fed Fed @relation(fields: [fedId], references: [id], onDelete: Cascade)
  bot Bot @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@id([fedId, botId, chatId])
  @@map("fed_chats")
}

/// Federation subscription: enforce another fed's ban list without
/// joining its chats (reference subfeds, max 5).
model FedSub {
  fedId         String @map("fed_id")
  subscribedFedId String @map("subscribed_fed_id")

  fed          Fed  @relation("FedSubscriptions", fields: [fedId], references: [id], onDelete: Cascade)
  subscribedFed Fed @relation("FedSubscribers", fields: [subscribedFedId], references: [id], onDelete: Cascade)

  @@id([fedId, subscribedFedId])
  @@map("fed_subs")
}

model BotModule {
  botId      String     @map("bot_id")
  moduleKey  String  @map("module_key")
  isEnabled  Int     @default(0) @map("is_enabled")
  configJson String? @map("config_json")

  bot Bot @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@id([botId, moduleKey])
  @@map("bot_modules")
}

model MiniApp {
  id           String     @id @default(uuid())
  botId        String     @map("bot_id")
  name         String
  slug         String  @unique
  templateType String  @map("template_type")
  title        String
  description  String?
  iconUrl      String? @map("icon_url")
  configJson   String? @map("config_json")
  themeJson    String? @map("theme_json")
  isActive     Int     @default(1) @map("is_active")
  createdAt    String? @map("created_at")
  updatedAt    String? @map("updated_at")

  bot    Bot            @relation(fields: [botId], references: [id], onDelete: Cascade)
  orders MiniAppOrder[]

  @@map("mini_apps")
}

model MiniAppOrder {
  id          String     @id @default(uuid())
  botId       String     @map("bot_id")
  appId       String     @map("app_id")
  telegramId  BigInt  @map("telegram_id")
  totalAmount Float   @map("total_amount")
  currency    String
  itemsJson   String  @map("items_json")
  status      String
  createdAt   String? @map("created_at")

  bot Bot     @relation(fields: [botId], references: [id], onDelete: Cascade)
  app MiniApp @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@map("mini_app_orders")
}

model BotSetting {
  botId String    @map("bot_id")
  key   String
  value String

  bot Bot @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@id([botId, key])
  @@map("bot_settings")
}

model BotUser {
  botId        String     @map("bot_id")
  telegramId   BigInt  @map("telegram_id")
  username     String?
  firstName    String? @map("first_name")
  lastName     String? @map("last_name")
  languageCode String? @default("en") @map("language_code")
  points       Int     @default(0)
  referrerId   BigInt? @map("referrer_id")
  tagsJson     String? @map("tags_json")
  firstSeenAt  String? @map("first_seen_at")
  lastSeenAt   String? @map("last_seen_at")

  bot Bot @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@id([botId, telegramId])
  @@map("bot_users")
}

model Link {
  id          String     @id @default(uuid())
  botId       String     @map("bot_id")
  title       String
  description String?
  url         String
  type        String
  orderIndex  Int     @default(0) @map("order_index")
  isActive    Int     @default(1) @map("is_active")
  clickCount  Int     @default(0) @map("click_count")
  createdAt   String? @map("created_at")

  bot Bot @relation(fields: [botId], references: [id], onDelete: Cascade)

  /// Serves broadcast CTR tracking lookups (`bc:<broadcastId>:<index>`).
  @@index([botId, title])
  @@map("links")
}

model Broadcast {
  id              String     @id @default(uuid())
  botId           String     @map("bot_id")
  targetType      String  @map("target_type")
  messageText     String  @map("message_text")
  mediaUrl        String? @map("media_url")
  buttonsJson     String? @map("buttons_json")
  /// Persisted target filters ({language, recentDays}) so interrupted
  /// broadcasts can resume with identical targeting.
  targetFilterJson String? @map("target_filter_json")
  totalRecipients Int     @default(0) @map("total_recipients")
  successCount    Int     @default(0) @map("success_count")
  failedCount     Int     @default(0) @map("failed_count")
  status          String
  /// Last processed recipient telegram id (progress checkpoint for resume).
  sentCursor      BigInt? @map("sent_cursor")
  /// A/B experiment group id (uuid); null for single-shot broadcasts.
  experimentId    String? @map("experiment_id")
  /// Variant label within the experiment ("A", "B", ...).
  variantLabel    String? @map("variant_label")
  /// Experiment phase: `test` (split sample), `final` (winner roll-out) or
  /// null for plain broadcasts.
  phase           String?
  /// Tracked inline-button clicks credited to this broadcast (CTR).
  clicks          Int     @default(0)
  createdAt       String? @map("created_at")

  bot Bot @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@index([botId, experimentId])
  @@index([botId, status])
  @@map("broadcasts")
}

/// Shared media library asset: a reusable URL or Telegram file_id that the
/// welcome/broadcast/drip/autoresponder composers pick instead of retyping.
model MediaAsset {
  id           String     @id @default(uuid())
  botId        String     @map("bot_id")
  name         String
  /// `url` (http(s) media link) or `file_id` (Telegram-uploaded file id).
  source       String  @default("url")
  /// The value modules consume — either the URL or the raw file_id.
  value        String
  kind         String  @default("photo")
  mimeType     String? @map("mime_type")
  fileSize     Int?    @map("file_size")
  tags         String?
  createdAt    String? @map("created_at")

  bot Bot @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@index([botId])
  @@map("media_assets")
}

/// Visual flow (multi-step conversation tree) built in the studio editor and
/// executed by the flows runtime: commands/keywords start a session, message
/// nodes reply, input nodes capture text, condition nodes branch, delay nodes
/// schedule continuation.
model Flow {
  id          String     @id @default(uuid())
  botId       String     @map("bot_id")
  name        String
  /// `command` | `keyword` | `start`
  triggerType String  @default("command") @map("trigger_type")
  /// Command (`/pricing`), keyword text, or empty for `start`.
  triggerValue String @default("") @map("trigger_value")
  /// Flow graph: `{ nodes: [...], start: nodeId }`.
  graphJson   String  @map("graph_json")
  isActive    Int     @default(1) @map("is_active")
  createdAt   String? @map("created_at")
  updatedAt   String? @map("updated_at")

  bot    Bot         @relation(fields: [botId], references: [id], onDelete: Cascade)
  states FlowState[]

  @@index([botId])
  @@map("flows")
}

/// Per-user runtime position inside a flow (current node, captured variables).
model FlowState {
  botId      String     @map("bot_id")
  flowId     String     @map("flow_id")
  telegramId BigInt  @map("telegram_id")
  nodeId     String  @map("node_id")
  /// Waiting for a text input node when set.
  waitInput  Int     @default(0) @map("wait_input")
  varsJson   String? @map("vars_json")
  /// Continuation time for delay nodes (ISO string); null otherwise.
  resumeAt   String? @map("resume_at")
  updatedAt  String? @map("updated_at")

  bot  Bot  @relation(fields: [botId], references: [id], onDelete: Cascade)
  flow Flow @relation(fields: [flowId], references: [id], onDelete: Cascade)

  /// Serves the per-message session lookup for private chats.
  @@index([botId, telegramId])
  /// Serves the delay-node resume scan on every tick.
  @@index([resumeAt])
  @@id([flowId, telegramId])
  @@map("flow_states")
}

/// Studio-level health alert raised by the bot health monitor (poller
/// failures, recoveries) with optional Telegram admin notification state.
model HealthEvent {
  id        String     @id @default(uuid())
  botId     String     @map("bot_id")
  /// `failed` | `recovering` | `recovered`
  level     String
  reason    String?
  message   String
  notified  Int     @default(0) @map("notified")
  createdAt String? @map("created_at")

  bot Bot @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@index([botId, createdAt])
  @@map("health_events")
}

/// Saved full-bot configuration bundle (same shape as export/import JSON)
/// listed in the template gallery and applied to bots in one click.
model BotTemplate {
  id          String     @id @default(uuid())
  name        String
  description String?
  bundleJson  String  @map("bundle_json")
  sourceBotName String? @map("source_bot_name")
  createdAt   String? @map("created_at")

  @@map("bot_templates")
}

model SupportMessage {
  id            String     @id @default(uuid())
  botId         String     @map("bot_id")
  telegramId    BigInt  @map("telegram_id")
  userMessageId Int?    @map("user_message_id")
  adminChatId   BigInt? @map("admin_chat_id")
  forumTopicId  Int?    @map("forum_topic_id")
  direction     String
  senderName    String? @map("sender_name")
  messageText   String? @map("message_text")
  mediaType     String? @map("media_type")
  createdAt     String? @map("created_at")

  bot Bot @relation(fields: [botId], references: [id], onDelete: Cascade)

  /// Serves the per-bot inbox load (every dashboard inbox open).
  @@index([botId])
  @@map("support_messages")
}

model DripCampaign {
  id        String    @id @default(uuid())
  botId     String    @map("bot_id")
  name      String
  stepsJson String @map("steps_json")
  isActive  Int    @default(1) @map("is_active")

  bot         Bot              @relation(fields: [botId], references: [id], onDelete: Cascade)
  subscribers DripSubscriber[]

  @@map("drip_campaigns")
}

model DripSubscriber {
  botId       String     @map("bot_id")
  campaignId  String     @map("campaign_id")
  telegramId  BigInt  @map("telegram_id")
  currentStep Int     @default(0) @map("current_step")
  nextRunAt   String? @map("next_run_at")

  bot      Bot          @relation(fields: [botId], references: [id], onDelete: Cascade)
  campaign DripCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  /// Consecutive transient delivery failures; unsubscribes after the limit.
  attempts Int @default(0)

  /// Serves the dispatcher's due-subscriber scan on every tick.
  @@index([nextRunAt])
  @@id([campaignId, telegramId])
  @@map("drip_subscribers")
}

model Giveaway {
  id                   String     @id @default(uuid())
  botId                String     @map("bot_id")
  title                String
  requiredChannelsJson String? @map("required_channels_json")
  winnersCount         Int     @default(1) @map("winners_count")
  prizeDetails         String? @map("prize_details")
  endsAt               String? @map("ends_at")
  status               String

  bot Bot @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@map("giveaways")
}

model ScheduledPost {
  id           String     @id @default(uuid())
  botId        String     @map("bot_id")
  targetChatId String  @map("target_chat_id")
  messageText  String  @map("message_text")
  mediaUrl     String? @map("media_url")
  buttonsJson  String? @map("buttons_json")
  scheduledAt  String  @map("scheduled_at")
  status       String

  bot Bot @relation(fields: [botId], references: [id], onDelete: Cascade)

  /// Serves the dispatcher's due-post scan on every tick.
  @@index([status, scheduledAt])
  @@map("scheduled_posts")
}

model BlockedUser {
  botId      String     @map("bot_id")
  telegramId BigInt  @map("telegram_id")
  username   String?
  firstName  String? @map("first_name")
  reason     String?
  blockedAt  String? @map("blocked_at")

  bot Bot @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@id([botId, telegramId])
  @@map("blocked_users")
}

model BotGroup {
  botId       String     @map("bot_id")
  chatId      BigInt  @map("chat_id")
  title       String
  type        String
  memberCount Int     @default(0) @map("member_count")
  isActive    Int     @default(1) @map("is_active")
  createdAt   String? @map("created_at")

  bot Bot @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@id([botId, chatId])
  @@map("bot_groups")
}

model ChatConnection {
  id        String     @id @default(uuid())
  botId     String     @map("bot_id")
  chatId    String  @map("chat_id")
  title     String
  type      String
  username  String?
  isActive  Int     @default(1) @map("is_active")
  createdAt String? @map("created_at")

  bot Bot @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@unique([botId, chatId])
  @@map("chat_connections")
}

model Autoresponder {
  id           String     @id @default(uuid())
  botId        String     @map("bot_id")
  command      String
  responseText String  @map("response_text")
  mediaUrl     String? @map("media_url")
  buttonsJson  String? @map("buttons_json")
  isActive     Int     @default(1) @map("is_active")
  /// Reference-parity v2: scoping and matching (null chatId = every chat).
  chatId       String? @map("chat_id")
  scope        String  @default("private") @map("scope")
  matchMode    String  @default("keyword") @map("match_mode")
  adminOnly    Int     @default(0) @map("admin_only")
  repeatSeconds Int    @default(0) @map("repeat_seconds")
  lastRepeatAt String? @map("last_repeat_at")

  bot Bot @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@map("autoresponders")
}

model VipSubscription {
  id         String    @id @default(uuid())
  botId      String    @map("bot_id")
  telegramId BigInt @map("telegram_id")
  channelId  BigInt @map("channel_id")
  expiresAt  String @map("expires_at")
  isActive   Int    @default(1) @map("is_active")

  bot Bot @relation(fields: [botId], references: [id], onDelete: Cascade)

  /// Serves the expiry sweeper scan.
  @@index([isActive, expiresAt])
  @@map("vip_subscriptions")
}

model Session {
  id           String  @id
  ip           String
  userAgent    String? @map("user_agent")
  browser      String
  os           String
  deviceType   String  @map("device_type")
  createdAt    String? @map("created_at")
  lastActiveAt String? @map("last_active_at")
  isRevoked    Int     @default(0) @map("is_revoked")

  /// Serves the retention prune of stale sessions.
  @@index([lastActiveAt])
  @@map("sessions")
}

model SecurityLog {
  id        String     @id @default(uuid())
  event     String
  ip        String?
  userAgent String? @map("user_agent")
  details   String?
  createdAt String? @map("created_at")

  @@map("security_logs")
}

model SystemSetting {
  key   String @id
  value String

  @@map("system_settings")
}

model ChatActivity {
  botId        String    @map("bot_id")
  chatId       String @map("chat_id")
  telegramId   BigInt @map("telegram_id")
  day          String
  messageCount Int    @default(0) @map("message_count")
  replyCount   Int    @default(0) @map("reply_count")
  mediaCount   Int    @default(0) @map("media_count")

  bot Bot @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@id([botId, chatId, telegramId, day])
  @@map("chat_activity")
}

model ScoreSchedule {
  id                  String     @id @default(uuid())
  botId               String     @map("bot_id")
  name                String
  chatIdsJson         String  @map("chat_ids_json")
  period              String  @default("weekly")
  frequency           String  @default("weekly")
  timeOfDay           String? @default("18:00") @map("time_of_day")
  dayOfWeek           Int?    @default(1) @map("day_of_week")
  runAt               String  @map("run_at")
  topLimit            Int     @default(10) @map("top_limit")
  headerText          String? @map("header_text")
  rowTemplate         String? @map("row_template")
  footerText          String? @map("footer_text")
  parseMode           String? @default("HTML") @map("parse_mode")
  medals              Int     @default(1)
  disableNotification Int     @default(0) @map("disable_notification")
  status              String  @default("active")
  lastRunAt           String? @map("last_run_at")
  lastResult          String? @map("last_result")
  createdAt           String? @map("created_at")

  bot Bot @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@map("score_schedules")
}

model AiChatHistory {
  id               String     @id @default(uuid())
  botId            String     @map("bot_id")
  telegramId       BigInt  @map("telegram_id")
  role             String
  content          String
  promptTokens     Int?    @map("prompt_tokens")
  completionTokens Int?    @map("completion_tokens")
  latencyMs        Int?    @map("latency_ms")
  isError          Boolean @default(false) @map("is_error")
  createdAt        String  @map("created_at")

  bot Bot @relation(fields: [botId], references: [id], onDelete: Cascade)

  /// Serves the per-conversation history load on every AI message.
  @@index([botId, telegramId])
  @@map("ai_chat_history")
}

model AiKnowledgeDoc {
  id        String     @id @default(uuid())
  botId     String     @map("bot_id")
  title     String
  content   String
  tags      String?
  createdAt String  @map("created_at")

  bot    Bot                @relation(fields: [botId], references: [id], onDelete: Cascade)
  chunks AiKnowledgeChunk[]

  @@map("ai_knowledge_docs")
}

/// Semantic RAG chunk with its optional embedding vector (JSON float array).
model AiKnowledgeChunk {
  id         String     @id @default(uuid())
  botId      String     @map("bot_id")
  docId      String     @map("doc_id")
  idx        Int
  content    String
  vectorJson String? @map("vector_json")
  createdAt  String  @map("created_at")

  bot Bot            @relation(fields: [botId], references: [id], onDelete: Cascade)
  doc AiKnowledgeDoc @relation(fields: [docId], references: [id], onDelete: Cascade)

  @@index([botId])
  @@index([docId])
  @@map("ai_knowledge_chunks")
}
