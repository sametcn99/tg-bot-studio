{
  "name": "tg-bot-studio",
  "version": "1.0.0",
  "description": "Enterprise Telegram Bot & Mini App Management Studio",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "bun run prisma:generate && tsc -p tsconfig.json && concurrently -n server,runner,client,tma -c blue,cyan,green,magenta \"tsc -p tsconfig.json --watch --preserveWatchOutput\" \"bun --watch dist/server/main.js\" \"vite\" \"vite -c vite.config.tma.ts\"",
    "dev:client": "vite",
    "dev:tma": "vite -c vite.config.tma.ts",
    "build": "bun run prisma:generate && tsc -p tsconfig.json && vite build && vite build -c vite.config.tma.ts",
    "start": "prisma migrate deploy && bun dist/server/main.js",
    "test": "bun test",
    "typecheck": "bun run prisma:generate && tsc -p tsconfig.json --noEmit && tsc -p src/client/tsconfig.json --noEmit && tsc -p src/client-tma/tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prisma:generate": "prisma generate",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:dev": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@grammyjs/auto-retry": "^2.0.2",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/serve-static": "^5.0.3",
    "@nestjs/swagger": "^12.0.2",
    "@prisma/client": "^6",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "grammy": "^1.36.3",
    "hash-wasm": "^4.12.0",
    "helmet": "^8.1.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "^5.2.8",
    "@mui/icons-material": "^7.3.4",
    "@mui/material": "^7.3.4",
    "@nestjs/testing": "^12.1.3",
    "@types/bun": "^1.3.3",
    "@types/express": "^5.0.5",
    "@types/passport-jwt": "^4.0.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "concurrently": "^9.2.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "i18next": "^25.6.1",
    "prettier": "^3.9.10",
    "prisma": "^6",
    "react": "^19.2.4",
    "react-dom": "^19.2.3",
    "react-i18next": "^16.2.4",
    "react-router-dom": "^7.10.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.3.2"
  }
}
